            "type": "string",
            "required": false,
            "binding": "/query/name",
            "description": "Return options with this name, compared case-insensitively. `?name=critical` matches `Critical`, so you can resolve a label to its option `id` without reading the whole list."
          },
          {
            "name": "external-id",
            "type": "string",
            "required": false,
            "binding": "/query/external_id",
            "description": "Return options whose `external_id` matches exactly. Use it to find the option you created earlier for a value in another system."
          },
          {
            "name": "external-source",
            "type": "string",
            "required": false,
            "binding": "/query/external_source",
            "description": "Return options from one source system, for example `jira`. Combine it with `external_id`, because an `external_id` is unique only within its source."
          },
          {
            "name": "order-by",
            "type": "string",
            "required": false,
            "binding": "/query/order_by",
            "description": "Field to sort by. Prefix with `-` for descending. - `sort_order` , `-sort_order`: the property's own display order. This is the default. - `created_at` , `-created_at`: when each option was added - `id` , `-id` A value outside this list is ignored and the default `sort_order` ordering is used, so a typo shows up as an unexpected order rather than an error."
          },
          {
            "name": "per-page",
            "type": "integer",
            "required": false,
            "binding": "/query/per_page",
            "description": "Page size. Defaults to 50, maximum 200. Most properties have fewer than 20 options, so one page is usually the whole list."
          },
          {
            "name": "offset",
            "type": "integer",
            "required": false,
            "binding": "/query/offset",
            "description": "Number of rows to skip from the start of the result set. Maximum 10000. Use the `next` value from the response instead of computing offsets yourself."
          },
          {
            "name": "paginate",
            "type": "string",
            "required": false,
            "binding": "/query/paginate",
            "description": "Set to `cursor` to switch to the keyset envelope, which skips the `COUNT` query and returns `next_cursor` and `has_more` instead of `next` and `total_count`. Leave it out to get the default offset envelope. Cursor pagination needs a unique, monotonic sort key, and `sort_order` is neither. Pair it with `order_by=created_at` or `order_by=id`; a bare `?paginate=cursor` falls back to the default `sort_order` ordering and is rejected with `ordering_not_cursor_eligible`."
          },
          {
            "name": "count",
            "type": "boolean",
            "required": false,
            "binding": "/query/count",
            "description": "Defaults to `true`. Set to `false` to skip the `COUNT(*)` behind `total_count`; the field is then omitted from the response."
          },
          {
            "name": "cursor",
            "type": "string",
            "required": false,
            "binding": "/query/cursor",
            "description": "Opaque continuation from the native cursor envelope."
          }
        ],
        "pagination": "v2"
      }
    }
