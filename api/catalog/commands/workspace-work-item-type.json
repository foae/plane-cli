          },
          {
            "name": "external-source",
            "type": "string",
            "required": false,
            "binding": "/query/external_source",
            "description": "Return types from one source system, for example `jira`. Combine it with `external_id`, because an `external_id` is unique only within its source."
          },
          {
            "name": "order-by",
            "type": "string",
            "required": false,
            "binding": "/query/order_by",
            "description": "Field to sort by. Prefix with `-` for descending. - `name` , `-name`: alphabetical, which is what you usually want for a picker - `level` , `-level`: the type's level in the work item hierarchy - `created_at` , `-created_at`: when each type was added - `id` , `-id` A value outside this list is not rejected, and the default ordering is used instead. Check your spelling, because a typo shows up as a differently sorted page, not as an error."
          },
          {
            "name": "per-page",
            "type": "integer",
            "required": false,
            "binding": "/query/per_page",
            "description": "Page size. Defaults to 50, maximum 200. Most workspaces define fewer than 20 types, so one page is usually the whole set."
          },
          {
            "name": "offset",
            "type": "integer",
            "required": false,
            "binding": "/query/offset",
            "description": "Number of rows to skip from the start of the result set. Maximum 10000. Use the `next` value from the response instead of computing offsets yourself."
          },
          {
            "name": "paginate",
            "type": "string",
            "required": false,
            "binding": "/query/paginate",
            "description": "Set to `cursor` to switch to the keyset envelope, which skips the `COUNT` query and returns `next_cursor` and `has_more` instead of `next` and `total_count`. Leave it out to get the default offset envelope."
          },
          {
            "name": "count",
            "type": "boolean",
            "required": false,
            "binding": "/query/count",
            "description": "Defaults to `true`. Set to `false` to skip the `COUNT(*)` behind `total_count`; the field is then omitted from the response."
          },
          {
            "name": "fields",
            "type": "string",
            "required": false,
            "binding": "/query/fields",
            "description": "Comma-separated list of fields to return on each row. Fields you don't request are left out of the response instead of coming back as `null`, so a missing key means you didn't ask for it and `null` means the value is null. `id` is always included, whether or not you name it. Pass `all` to get every requestable field. An unknown field name returns `400` with the list of valid names and the closest match, so a typo is caught instead of being silently ignored. Requestable here: `created_at`, `description`, `external_id`, `external_source`, `governance_mode`, `id`, `is_active`, `is_active_in_project`, `is_default`, `is_default_in_project`, `is_epic`, `level`, `logo_props`, `name`, `project_ids`, `rollout`, `updated_at`, `updated_by_id`. See [Sparse fields](/api-reference/v2/sparse-fields)."
          },
          {
            "name": "cursor",
            "type": "string",
            "required": false,
            "binding": "/query/cursor",
            "description": "Opaque continuation from the native cursor envelope."
          }
        ],
        "pagination": "v2"
      }
