            "binding": "/flags/anchor",
            "description": "anchor"
          },
          {
            "name": "fields",
            "type": "string",
            "required": false,
            "binding": "/query/fields",
            "description": "fields"
          },
          {
            "name": "expand",
            "type": "string",
            "required": false,
            "binding": "/query/expand",
            "description": "expand"
          }
        ],
        "pagination": "none"
      }
    },
    "local": false
  }
]
