[
  {
    "path": [
      "published-page",
      "get"
    ],
    "handler": "published-page-get",
    "summary": "Read a published page by 32-character hex anchor, not page id; requires workspace-valid authentication (v2)",
    "side_effect": "read",
    "examples": [
      "plane-cli published-page get --help"
    ],
    "versions": {
      "v2": {
        "method": "GET",
        "route": "/api/v2/workspaces/{slug}/published-pages/{anchor}/",
        "response_kind": "native",
        "scopes": [
          "projects.pages:read"
        ],
        "schema": {
          "type": "object",
          "properties": {
            "arguments": {
              "type": "array",
              "maxItems": 0
            },
            "flags": {
              "type": "object",
              "properties": {
                "api-version": {
                  "type": "string",
                  "const": "v2"
                },
                "workspace": {
                  "type": "string"
                },
                "connection": {
                  "type": "string"
                },
                "base-url": {
                  "type": "string"
                },
                "auth-mode": {
                  "type": "string"
                },
                "credential-backend": {
                  "type": "string"
                },
                "timeout": {
                  "type": "string"
                },
                "request-timeout": {
                  "type": "string"
                },
                "ca-file": {
                  "type": "string"
                },
                "dry-run": {
                  "type": "boolean"
                },
                "anchor": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32,
                  "pattern": "^[0-9a-fA-F]{32}$"
                }
              },
              "additionalProperties": false,
              "required": [
                "api-version",
                "workspace",
                "anchor"
              ]
            },
            "query": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "string"
                },
                "expand": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "arguments",
            "flags"
          ]
        },
        "flags": [
          {
            "name": "api-version",
            "type": "string",
            "required": true,
            "binding": "/flags/api-version",
            "description": "api version"
          },
          {
            "name": "workspace",
            "type": "string",
            "required": true,
            "binding": "/flags/workspace",
            "description": "workspace"
          },
          {
            "name": "connection",
            "type": "string",
            "required": false,
            "binding": "/flags/connection",
            "description": "connection"
          },
          {
            "name": "base-url",
            "type": "string",
            "required": false,
            "binding": "/flags/base-url",
            "description": "base url"
          },
          {
            "name": "auth-mode",
            "type": "string",
            "required": false,
            "binding": "/flags/auth-mode",
            "description": "auth mode"
          },
          {
            "name": "credential-backend",
            "type": "string",
            "required": false,
            "binding": "/flags/credential-backend",
            "description": "credential backend"
          },
          {
            "name": "timeout",
            "type": "string",
            "required": false,
            "binding": "/flags/timeout",
            "description": "timeout"
          },
          {
            "name": "request-timeout",
            "type": "string",
            "required": false,
            "binding": "/flags/request-timeout",
            "description": "request timeout"
          },
          {
            "name": "ca-file",
            "type": "string",
            "required": false,
            "binding": "/flags/ca-file",
            "description": "ca file"
          },
          {
            "name": "dry-run",
            "type": "boolean",
            "required": false,
