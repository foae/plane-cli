[
  {
    "path": [
      "connection",
      "add"
    ],
    "handler": "connection-add",
    "summary": "Add named connection configuration",
    "side_effect": "local",
    "examples": [
      "plane-cli connection add example --base-url https://plane.example.net --api-version v2"
    ],
    "local": true,
    "versions": {
      "v1": {
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "arguments": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 1
            },
            "flags": {
              "type": "object",
              "properties": {
                "base-url": {
                  "type": "string"
                },
                "api-version": {
                  "type": "string",
                  "enum": [
                    "v1",
                    "v2"
                  ]
                },
                "workspace": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "auth-mode": {
                  "type": "string",
                  "enum": [
                    "api-key",
                    "bearer",
                    "external",
                    "oauth-user",
                    "oauth-bot"
                  ]
                },
                "credential-backend": {
                  "type": "string",
                  "enum": [
                    "file",
                    "keyring",
                    "env"
                  ]
                },
                "timeout": {
                  "type": "string"
                },
                "request-timeout": {
                  "type": "string"
                },
                "ca-file": {
                  "type": "string"
                },
                "dry-run": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "base-url",
                "api-version"
              ]
            }
          },
          "required": [
            "arguments",
            "flags"
          ],
          "additionalProperties": false
        },
        "flags": [
          {
            "name": "base-url",
            "type": "string",
            "required": true,
            "binding": "/flags/base-url",
            "description": "Instance origin and optional proxy prefix"
          },
          {
            "name": "api-version",
            "type": "string",
            "required": true,
            "binding": "/flags/api-version",
            "description": "Explicit API generation v1 or v2"
          },
          {
            "name": "workspace",
            "type": "string",
            "required": false,
            "binding": "/flags/workspace",
            "description": "Default workspace"
          },
          {
            "name": "project",
            "type": "string",
            "required": false,
            "binding": "/flags/project",
            "description": "Default project"
          },
          {
            "name": "auth-mode",
            "type": "string",
            "required": false,
            "binding": "/flags/auth-mode",
            "description": "api-key, bearer, external, oauth-user or oauth-bot"
          },
          {
            "name": "credential-backend",
            "type": "string",
            "required": false,
            "binding": "/flags/credential-backend",
            "description": "file (owner-only plaintext), keyring or env"
          },
          {
            "name": "timeout",
            "type": "string",
            "required": false,
            "binding": "/flags/timeout",
            "description": "Total positive duration (default 5m)"
          },
          {
            "name": "request-timeout",
            "type": "string",
            "required": false,
            "binding": "/flags/request-timeout",
            "description": "Per-request positive duration (default 30s)"
          },
          {
            "name": "ca-file",
            "type": "string",
            "required": false,
            "binding": "/flags/ca-file",
            "description": "Additional PEM CA certificates"
          },
          {
            "name": "dry-run",
            "type": "boolean",
            "required": false,
            "binding": "/flags/dry-run",
            "description": "Validate without changing configuration"
          }
        ]
      },
