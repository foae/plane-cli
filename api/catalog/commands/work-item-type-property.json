          {
            "name": "order-by",
            "type": "string",
            "required": false,
            "binding": "/query/order_by",
            "description": "Field to sort by. Prefix with `-` for descending.\n\n- `sort_order` , `-sort_order`: the order the properties are shown in, and the default\n- `created_at` , `-created_at`: when each property was created\n- `id` , `-id`\n\nOrder by `sort_order` when you are rendering the type's form to a user; it is the order Plane uses. `sort_order` is\nnot part of the returned property object, so sort by `created_at` or `id` if you need the sort key to be visible in the\npayload."
          },
          {
            "name": "per-page",
            "type": "integer",
            "required": false,
            "binding": "/query/per_page",
            "description": "Page size. Defaults to 50, maximum 200. Most types have only a few properties, so one page usually holds all of them."
          },
          {
            "name": "offset",
            "type": "integer",
            "required": false,
            "binding": "/query/offset",
            "description": "Number of rows to skip from the start of the result set. Maximum 10000. Read the `next` value from the response rather\nthan computing offsets yourself."
          },
          {
            "name": "paginate",
            "type": "string",
            "required": false,
            "binding": "/query/paginate",
            "description": "Set to `cursor` to switch to the keyset envelope (no `COUNT` query), which returns `next_cursor` and `has_more` instead of\n`next` and `total_count`. Pair it with `order_by=created_at` or `order_by=id`. The default `sort_order` is not a\nunique key, so it is not cursor-eligible. Omit the parameter for the default offset envelope."
          },
          {
            "name": "count",
            "type": "boolean",
            "required": false,
            "binding": "/query/count",
            "description": "Defaults to `true`. Set to `false` to skip the `COUNT(*)` behind `total_count`; the field is then omitted from the\nresponse."
          },
          {
            "name": "fields",
            "type": "string",
            "required": false,
            "binding": "/query/fields",
            "description": "Comma-separated list of fields to return on each row. Fields you don't request are left out of the response instead of coming back as `null`, so a missing key means you didn't ask for it and `null` means the value is null. `id` is always included, whether or not you name it.\n\nPass `all` to get every requestable field. An unknown field name returns `400` with the list of valid names and the closest match, so a typo is caught instead of being silently ignored.\n\nRequestable here: `created_at`, `default_value`, `description`, `display_name`, `external_id`, `external_source`, `id`, `is_active`, `is_multi`, `is_required`, `logo_props`, `name`, `options`, `property_type`, `relation_type`, `settings`, `updated_at`, `updated_by_id`, `validation_rules`.\n\nSee [Sparse fields](/api-reference/v2/sparse-fields)."
          },
          {
            "name": "cursor",
            "type": "string",
            "required": false,
            "binding": "/query/cursor",
            "description": "Opaque next_cursor continuation documented by the list response."
          }
        ],
        "pagination": "v2"
