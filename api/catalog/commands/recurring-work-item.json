            "type": "boolean",
            "required": false,
            "binding": "/query/enabled",
            "description": "`true` returns active schedules. `false` returns schedules Plane turned off itself, because a run found that the workspace's plan no longer includes recurring work items or because the blueprint's work item type was removed from the project."
          },
          {
            "name": "interval-type",
            "type": "string",
            "required": false,
            "binding": "/query/interval_type",
            "description": "Return only schedules with this interval. One of `daily`, `weekly`, `monthly`, or `yearly`. Use `interval_type__in` to match several, comma-separated: `?interval_type__in=weekly,monthly`."
          },
          {
            "name": "interval-count",
            "type": "integer",
            "required": false,
            "binding": "/query/interval_count",
            "description": "Return only schedules with this interval count."
          },
