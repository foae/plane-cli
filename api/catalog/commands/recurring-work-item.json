          },
          {
            "name": "next-scheduled-at-lte",
            "type": "string",
            "required": false,
            "binding": "/query/next_scheduled_at__lte",
            "description": "Return schedules whose next run is at or before this time."
          },
          {
            "name": "search",
            "type": "string",
            "required": false,
            "binding": "/query/search",
            "description": "A search term matched against the blueprint name."
          },
          {
            "name": "order-by",
            "type": "string",
            "required": false,
            "binding": "/query/order_by",
            "description": "Field to sort by. Prefix with `-` for descending. Defaults to `-created_at`. - `created_at`, `-created_at` - `id`, `-id` - `start_at`, `-start_at` - `next_scheduled_at`, `-next_scheduled_at`"
          },
          {
            "name": "per-page",
            "type": "integer",
            "required": false,
            "binding": "/query/per_page",
            "description": "Page size. Defaults to 50, maximum 200."
          },
          {
            "name": "offset",
            "type": "integer",
            "required": false,
            "binding": "/query/offset",
            "description": "Number of rows to skip from the start of the result set. Maximum 10000. Use the `next` value from the response instead of computing offsets yourself."
          },
          {
            "name": "paginate",
            "type": "string",
            "required": false,
            "binding": "/query/paginate",
            "description": "Set to `cursor` to switch to the keyset envelope (no `COUNT` query), which returns `next_cursor` and `has_more` instead of `next` and `total_count`. Cursor pagination works with the default ordering and with `created_at` or `id`. Ordering by `start_at` or `next_scheduled_at` with a cursor returns `400 ordering_not_cursor_eligible`."
          },
          {
            "name": "count",
            "type": "boolean",
            "required": false,
            "binding": "/query/count",
            "description": "Defaults to `true`. Set to `false` to skip the `COUNT(*)` behind `total_count`. The response then omits `total_count`."
          },
          {
            "name": "fields",
            "type": "string",
            "required": false,
            "binding": "/query/fields",
            "description": "Comma-separated list of fields to return on each row. Fields you don't request are left out of the response instead of coming back as `null`, so a missing key means you didn't ask for it and `null` means the value is null. `id` is always included, whether or not you name it. Pass `all` to get every requestable field. An unknown field name returns `400` with the list of valid names and the closest match, so a typo is caught instead of being silently ignored. Requestable here: `assignee_ids`, `created_at`, `created_by_id`, `description_html`, `enabled`, `end_at`, `id`, `interval_count`, `interval_type`, `label_ids`, `last_run_at`, `module_ids`, `name`, `next_scheduled_at`, `priority`, `schedule_description`, `start_at`, `state_id`, `type_id`, `updated_at`, `updated_by_id`, `work_item_blueprint_id`. See [Sparse fields](/api-reference/v2/sparse-fields)."
          },
