            "name": "start-at-gte",
            "type": "string",
            "required": false,
            "binding": "/query/start_at__gte",
            "description": "Return schedules whose `start_at` is at or after this time. Pair it with `start_at__lte` for a range."
          },
          {
            "name": "start-at-lte",
            "type": "string",
            "required": false,
            "binding": "/query/start_at__lte",
            "description": "Return schedules whose `start_at` is at or before this time."
          },
          {
            "name": "next-scheduled-at-gte",
            "type": "string",
            "required": false,
            "binding": "/query/next_scheduled_at__gte",
