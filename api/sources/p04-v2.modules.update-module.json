{
  "source_url": "https://developers.plane.so/api-reference/v2/modules/update-module.md",
  "source_sha256": "9252f595e152bc9f9c4f5aab08375f4ab4f0bb2f5059221c422b59ce1e5a9700",
  "operation_id": "v2.modules.update-module",
  "method": "PATCH",
  "path": "/api/v2/workspaces/{slug}/projects/{project_id}/modules/{pk}/",
  "request_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "pk": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "slug",
          "project_id",
          "pk"
        ]
      },
      "query": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string"
          },
          "expand": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "body": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "planned",
              "in-progress",
              "paused",
              "completed",
              "cancelled"
            ]
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "target_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lead_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "sort_order": {
            "type": "number"
          },
          "logo_props": true,
          "external_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "external_source": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "required": [
      "path",
      "body"
    ]
  },
  "statuses": [
    200
  ],
  "pagination": "none",
  "scopes": [
    "projects.modules:write"
  ],
  "notes": [
    "Native response shape is preserved; no documentation examples are used as closed response schemas."
  ]
}
