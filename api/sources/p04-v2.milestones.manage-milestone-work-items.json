{
  "source_url": "https://developers.plane.so/api-reference/v2/milestones/manage-milestone-work-items.md",
  "source_sha256": "a9fa053f0bc6a5d532021f12f6e8d143fe417fdf5dd91a85acbeb392e4ccb6f4",
  "operation_id": "v2.milestones.manage-milestone-work-items",
  "method": "POST",
  "path": "/api/v2/workspaces/{slug}/projects/{project_id}/milestones/{pk}/work-items/",
  "request_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "pk": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "slug",
          "project_id",
          "pk"
        ]
      },
      "query": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "body": {
        "type": "object",
        "properties": {
          "add": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "required": [
      "path",
      "body"
    ]
  },
  "statuses": [
    200
  ],
  "pagination": "none",
  "scopes": [
    "projects.milestones:write"
  ],
  "notes": [
    "Native response shape is preserved; no documentation examples are used as closed response schemas.",
    "Requires --yes only when remove is nonempty; add-only and explicit empty remove do not require confirmation."
  ]
}
