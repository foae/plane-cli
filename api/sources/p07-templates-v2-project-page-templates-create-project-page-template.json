{
  "id": "v2.project-page-templates.create-project-page-template",
  "source_url": "https://developers.plane.so/api-reference/v2/project-page-templates/create-project-page-template.md",
  "method": "POST",
  "path": "/api/v2/workspaces/{slug}/projects/{project_id}/page-templates/",
  "request_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "slug",
          "project_id"
        ]
      },
      "query": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "body": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "short_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "description_html": {
            "type": "string"
          },
          "is_published": {
            "type": "boolean"
          },
          "template_data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "description_html": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "parent": {
                "anyOf": [
                  {
                    "type": "object",
                    "maxProperties": 0
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                      },
                      "project_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                      },
                      "project_identifier": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "project_id",
                      "project_identifier"
                    ]
                  }
                ]
              },
              "view_props": {
                "type": "object"
              },
              "logo_props": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "required": [
              "name"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "template_data"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "path",
      "body"
    ]
  },
  "responses": [
    {
      "status": 201,
      "content_type": "application/json",
      "schema": true
    }
  ],
  "pagination": "none",
  "scopes": [
    "templates.pages:write"
  ],
  "side_effect": "write",
  "notes": []
}
