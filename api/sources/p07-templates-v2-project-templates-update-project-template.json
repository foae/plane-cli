{
  "id": "v2.project-templates.update-project-template",
  "source_url": "https://developers.plane.so/api-reference/v2/project-templates/update-project-template.md",
  "method": "PATCH",
  "path": "/api/v2/workspaces/{slug}/project-templates/{pk}/",
  "request_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "pk": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "slug",
          "pk"
        ]
      },
      "query": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "body": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "short_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "description_html": {
            "type": "string"
          },
          "is_published": {
            "type": "boolean"
          },
          "template_data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "description": {
                "type": "string"
              },
              "network": {
                "type": "integer",
                "enum": [
                  0,
                  2
                ]
              },
              "default_assignee": {
                "type": "object"
              },
              "project_lead": {
                "type": "object"
              },
              "logo_props": {
                "type": "object"
              },
              "cover_asset": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timezone": {
                "type": "string"
              },
              "archive_in": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              },
              "close_in": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              },
              "priority": {
                "type": "string",
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "urgent"
                ]
              },
              "start_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "module_view": {
                "type": "boolean"
              },
              "cycle_view": {
                "type": "boolean"
              },
              "issue_views_view": {
                "type": "boolean"
              },
              "page_view": {
                "type": "boolean"
              },
              "intake_view": {
                "type": "boolean"
              },
              "is_time_tracking_enabled": {
                "type": "boolean"
              },
              "is_issue_type_enabled": {
                "type": "boolean"
              },
              "is_project_updates_enabled": {
                "type": "boolean"
              },
              "is_epic_enabled": {
                "type": "boolean"
              },
              "is_workflow_enabled": {
                "type": "boolean"
              },
              "is_milestone_enabled": {
                "type": "boolean"
              },
              "guest_view_all_features": {
                "type": "boolean"
              },
              "states": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "labels": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "workitem_types": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "project_state": {
                "type": "object"
              },
              "estimates": {
                "type": "object"
              },
              "epics": {
                "type": "object"
              },
              "intake_settings": {
                "type": "object"
              },
              "workflows": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "milestones": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "modules": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "recurring_work_items": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "automations": {
                "type": [
                  "object",
                  "array"
                ]
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "id"
                  ]
                }
              },
              "workitems": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 255
                    },
                    "description_html": {
                      "type": "string"
                    },
                    "priority": {
                      "type": "string",
                      "enum": [
                        "none",
                        "low",
                        "medium",
                        "high",
                        "urgent"
                      ]
                    },
                    "state": {
                      "type": "object"
                    },
                    "assignees": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "labels": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "type": {
                      "type": "object"
                    },
                    "modules": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "properties": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "name"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "required": [
      "path",
      "body"
    ]
  },
  "responses": [
    {
      "status": 200,
      "content_type": "application/json",
      "schema": true
    }
  ],
  "pagination": "none",
  "scopes": [
    "templates.projects:write"
  ],
  "side_effect": "write",
  "notes": [
    "Sending template_data requires --yes because seed replacement can remove omitted content. No pre-read, merge, migration, or retry is performed.",
    "template_data.workitems replaces and omission clears; omitted members resets []; omitted or null cover_asset resets empty; other seed keys merge upstream."
  ]
}
