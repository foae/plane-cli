{
  "id": "v2.workspace-views.update-workspace-view",
  "source_url": "https://developers.plane.so/api-reference/v2/workspace-views/update-workspace-view.md",
  "method": "PATCH",
  "path": "/api/v2/workspaces/{slug}/views/{pk}/",
  "request_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "pk": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "slug",
          "pk"
        ]
      },
      "query": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string"
          },
          "expand": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "body": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "access": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "display_filters": {
            "type": "string"
          },
          "display_properties": {
            "type": "string"
          },
          "filters": {
            "type": "string"
          },
          "is_locked": {
            "type": "boolean"
          },
          "logo_props": {
            "type": "string"
          },
          "pql_filters": {
            "type": "string"
          },
          "sort_order": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "required": [
      "path",
      "body"
    ]
  },
  "responses": [
    {
      "status": 200,
      "content_type": "application/json",
      "schema": true
    }
  ],
  "pagination": "none",
  "scopes": [
    "workspaces.views:write"
  ],
  "side_effect": "write",
  "notes": [
    "Write access is a string per operation parameters; integer response and list-filter access are distinct. Saved filters/display values and pql_filters are strings and are never parsed or translated. Stored query is read-only."
  ]
}
